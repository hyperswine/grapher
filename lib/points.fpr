# Shared, checkout-independent point operations. Coordinates really are I32.
List = use "std/list".
R = use "std/result".
String = use "std/string".

point : Int -> Int -> (I32, I32) .
point x y = (I32.trunc x, I32.trunc y).

integer : I32 -> Int .
integer x = case I32.toInt x of Ok n -> n | Err why -> error why.

coordinates : (I32, I32) -> (Int, Int) .
coordinates p = (x, y) = p; (integer x, integer y).

name 0 = "Parabola".
name 1 = "Triangle wave".
name n = "Constellation".

curve kind x = if kind == 0 then x * x / 20 - 10
  else 10 - Int.abs ((x + 20) % 20 - 10) * 2.

sample : Int -> Vector (I32, I32) .
sample kind = if kind == 2 then Vec.fromList
  [point -17 5, point -12 -4, point -8 7, point -3 1, point 2 -7,
   point 5 6, point 9 -2, point 13 8, point 18 -5]
  else Vec.fromList (List.map (fn n -> x = n * 2; point x (curve kind x)) (List.range -10 10)).

shift : Int -> Int -> Vector (I32, I32) -> Vector (I32, I32) .
shift dx dy points = Vec.map (fn p -> (x, y) = p; (x + I32.trunc dx, y + I32.trunc dy)) points.

# Direct I32 field compares: List.member would use generic == on the pair.
contains : Int -> Int -> List (I32, I32) -> Bool .
contains x y points = hasPoint (I32.trunc x) (I32.trunc y) points.
hasPoint : I32 -> I32 -> (ps : List (I32, I32) | measure ps) -> Bool .
hasPoint x y ps = case ps of
    Nil -> False
  | p :: rest -> (px, py) = p; if px == x and py == y then True else hasPoint x y rest.

stats : Vector (I32, I32) -> (Int, Int, Int) .
stats points =
  (result, owned) = Vec.fold (fn acc p ->
    (n, sx, sy) = acc; (x, y) = coordinates p; (n + 1, sx + x, sy + y)) (0, 0, 0) points;
  _ = Vec.free owned;
  result.

parse text = case String.split "," text of
    [x, y] -> (case I32.parse x of
        Err why -> Err "x: {why}"
      | Ok a -> (case I32.parse y of Err why -> Err "y: {why}" | Ok b -> Ok (a, b)))
  | other -> Err "expected x,y (two I32 coordinates)".

parseAll : List String -> Result (List (I32, I32)) String .
parseAll tokens = R.traverse (fn token -> R.mapError (fn why -> "{token}: {why}") (parse token)) tokens.

# Viewport is x = -20..20, y = -10..10 (41 x 21 = 861 cells).
# Index (x + 20) + (y + 10) * 41. Occupied cells are 1, empty are 0.
cellGlyph x y occupied = if occupied == 1 then "*"
  else if x == 0 and y == 0 then "+"
  else if x == 0 then "|" else if y == 0 then "-" else " ".

inView x y = x >= (0 - 20) and x <= 20 and y >= (0 - 10) and y <= 10.

gridIx x y = (x + 20) + (y + 10) * 41.

paint : Vector Int -> (I32, I32) -> Vector Int .
paint grid p =
  (x, y) = coordinates p;
  if inView x y then Vec.set (gridIx x y) 1 grid else grid.

fillRow : Vector Int -> Int -> (xs : List Int | measure xs) -> String -> (String, Vector Int) .
fillRow grid y xs acc = case xs of
    Nil -> (acc, grid)
  | x :: rest ->
      (occupied, grid2) = Vec.get (gridIx x y) grid;
      fillRow grid2 y rest "{acc}{cellGlyph x y occupied}".

fillRows : Vector Int -> (rows : List Int | measure rows) -> List String -> (List String, Vector Int) .
fillRows grid rows acc = case rows of
    Nil -> (acc, grid)
  | row :: rest ->
      y = 10 - row;
      (line, grid2) = fillRow grid y (List.range (0 - 20) 20) "";
      fillRows grid2 rest (line :: acc).

# One occupancy grid per plot: paint every point, then look up each cell.
# Output is byte-identical to the old per-cell List.member walk.
ascii : Vector (I32, I32) -> String .
ascii points =
  (painted, owned) = Vec.fold paint (Vec.fromList (List.repeat 861 0)) points;
  (linesRev, grid) = fillRows painted (List.range 0 20) Nil;
  _ = Vec.free grid;
  _ = Vec.free owned;
  strJoin "\n" (List.reverse linesRev).
